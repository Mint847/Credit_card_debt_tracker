rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each account can read and write only its own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bank promotions are public (the Offers screen loads before sign-in).
    // Only the admin account (custom claim set by tools/set-admin.js) can publish or edit them;
    // the weekly collector writes with the Admin SDK, which these rules don't apply to.
    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Collector output waiting for review: admin only
    match /offer_drafts/{draftId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Last collector run ("Offers updated ..."): public to read, admin to write
    match /offers_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
